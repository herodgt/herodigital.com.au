---
import LimeBackdrop from '../../components/LimeBackdrop.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PlanGrid from '../../components/PlanGrid.astro';
import OfferJsonLd from '../../components/OfferJsonLd.astro';
import { aiPlans, money } from '../../data/content';
---
<Base
  title="AI Visibility for implant clinics"
  description="Fix Sprint $1,495, then Starter $1,995, Growth $2,995 and Premium $4,995 a month plus $1,995 setup. How Hero Digital helps Australian implant clinics get named in AI answers — without guaranteeing a result."
  path="/ai-visibility/"
>
  <OfferJsonLd offers={[
    { name: 'AI Visibility Fix Sprint', path: '/ai-visibility/fix-sprint/', description: 'One-off technical and content sprint, re-audited after 30 days.', price: 1495, priceType: 'one-off' as const },
    ...aiPlans.map((p) => ({ name: `AI Visibility ${p.name}`, path: '/ai-visibility/', description: p.who, price: p.price, priceType: 'month' as const })),
  ]} />
  <PageHero
    eyebrow="AI Visibility"
    title="The work that helps AI tools find, read and cite an implant clinic."
    lead="We don’t control what a model says. We do control whether your site can be crawled, whether implant pages are structured and quotable, and whether listings, reviews and mentions back the same story."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/ai-visibility/', label: 'AI Visibility' }]}
  />
  <section class="section">
    <div class="wrap prose">
      <h2>What “AI visibility” means here</h2>
      <p>Patients type questions such as “Who should I see for dental implants in [suburb]?” or “How much is All-on-4 in Brisbane?” into ChatGPT, Perplexity, Gemini and Google’s AI answers. Some clinics are named in those answers and others aren’t.</p>
      <p>Our work sits underneath those answers: crawler access (including GPTBot, OAI-SearchBot, PerplexityBot and others), schema, an llms.txt file, implant and full-arch pages that can actually be quoted, consistent listings, and a careful review programme. Every public asset is Ahpra-pre-screened, human-reviewed and approved by you in writing.</p>
    </div>
  </section>
  <section class="section bg-paper" id="plans">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h2>A one-off sprint, then three monthly plans.</h2>
      <p class="lead">Start with the $1,495 Fix Sprint if you want a first pass. Move to a retainer when you’re ready. Setup on the monthly plans is {money(1995)}. Extra location: {money(1995)} a month plus {money(995)} setup. All figures AUD ex GST.</p>
      <div class="plans" style="margin-top:36px" data-stagger>
        <article class="plan">
          <h3>Fix Sprint</h3>
          <p class="who">Crawler access, schema, llms.txt, implant page structure and listings, then a re-audit after 30 days.</p>
          <div class="amt">{money(1495)} <span>one-off</span></div>
          <p class="setup">Credited toward setup if you move to a plan</p>
          <ul>
            <li>Technical crawl of the live site</li>
            <li>Robots, schema and llms.txt fixes</li>
            <li>Implant page and listing work</li>
            <li>Written re-audit after 30 days</li>
          </ul>
          <a class="btn btn-dark" href="/ai-visibility/fix-sprint/">See the sprint</a>
        </article>
      </div>
      <div style="margin-top:36px">
        <PlanGrid plans={aiPlans} />
      </div>
      <p class="fine" style="margin-top:22px">Targets such as extra qualified implant enquiries are aims set from your own baseline. They are reported monthly and are not guaranteed. Existing Hero SEO clients already receive AI visibility inside their retainer, so these plans are not sold to them. 90-day minimum on retainers, then month to month.</p>
    </div>
  </section>
  <section class="cta-shell">
    <div class="wrap">
    <div class="cta-band">
      <LimeBackdrop />
      <h2>See how your clinic appears in a technical crawl.</h2>
      <div class="btn-row" style="justify-content:center;margin-top:16px">
        <a class="btn btn-primary" href="/#audit">Get an instant audit</a>
        <a class="btn btn-ghost" href="/hero-one/">View Hero One</a>
      </div>
    </div>
    </div>
  </section>
</Base>
