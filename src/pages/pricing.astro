---
import LimeBackdrop from '../components/LimeBackdrop.astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanGrid from '../components/PlanGrid.astro';
import OfferJsonLd from '../components/OfferJsonLd.astro';
import { aiPlans, growthTiers, websitePackages, money } from '../data/content';
---
<Base
  title="Pricing"
  description="Public prices for Hero Digital’s AI visibility plans, Fix Sprint, growth services, websites and Market Leader. All figures AUD ex GST. Targets are aims, not guarantees."
  path="/pricing/"
>
  <OfferJsonLd offers={[
    { name: 'AI Visibility Fix Sprint', path: '/ai-visibility/fix-sprint/', description: 'One-off sprint.', price: 1495 },
    ...aiPlans.map((p) => ({ name: `AI Visibility ${p.name}`, path: '/ai-visibility/plans/', description: p.who, price: p.price, priceType: 'month' as const })),
    ...growthTiers.map((p) => ({ name: `Growth services ${p.name}`, path: '/growth-services/', description: p.who, price: p.price, priceType: 'month' as const })),
    ...websitePackages.map((p) => ({ name: `${p.name} website`, path: '/websites/', description: p.pages, price: p.price })),
    { name: 'Market Leader', path: '/market-leader/', description: 'VIP retainer, by application.', price: 9995, priceType: 'month' as const },
  ]} />
  <PageHero
    eyebrow="Pricing"
    title="The full ladder, with every price visible."
    lead="All figures are AUD ex GST. Targets on retainers are aims measured against your baseline — they are reported, not guaranteed. Growth-service names and Market Leader terms marked as proposed are still being confirmed as we go."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/pricing/', label: 'Pricing' }]}
  />

  <section class="section-sm">
    <div class="wrap table-wrap">
      <table class="data">
        <thead>
          <tr><th>Level</th><th>Offer</th><th>Price</th><th></th></tr>
        </thead>
        <tbody>
          <tr><td>0</td><td>Free AI Visibility Audit</td><td class="num">Free</td><td><a href="/free-audit/">Request</a></td></tr>
          <tr><td>1</td><td>AI Visibility Fix Sprint</td><td class="num">$1,495 one-off</td><td><a href="/ai-visibility/fix-sprint/">Details</a></td></tr>
          <tr><td>2</td><td>Starter / Growth / Premium</td><td class="num">$1,995 / $2,995 / $4,995 a month + $1,995 setup</td><td><a href="/ai-visibility/plans/">Compare</a></td></tr>
          <tr><td></td><td>Extra location</td><td class="num">$1,995/mo + $995 setup</td><td></td></tr>
          <tr><td>3</td><td>Growth services (after a fit check)</td><td class="num">$2,495 / $3,995 / $5,995 a month (proposed names)</td><td><a href="/growth-services/">Details</a></td></tr>
          <tr><td>4</td><td>Launch / Signature / Flagship websites</td><td class="num">$9,995 / $14,995 / $19,995</td><td><a href="/websites/">Details</a></td></tr>
          <tr><td>5</td><td>Market Leader (by application)</td><td class="num">$9,995 a month</td><td><a href="/market-leader/">Apply</a></td></tr>
        </tbody>
      </table>
      <p class="fine">90-day minimum on AI Visibility plans, then month to month with 30 days’ notice. Ad spend is always paid separately. Website payment is 50% upfront, then 10% of the package price per month, or pay off early.</p>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap">
      <h2>AI Visibility plans</h2>
      <p class="lead">The core retainers. Setup is credited if you have already bought the Fix Sprint.</p>
      <div style="margin-top:28px"><PlanGrid plans={aiPlans} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Growth services</h2>
      <p class="lead">Published prices, sold only after a fit check. Names and scopes are proposed. Ad spend is separate.</p>
      <div style="margin-top:28px"><PlanGrid plans={growthTiers} ctaHref="/growth-services/fit-check/" ctaLabel="Check if we’re a good fit" /></div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="wrap">
      <h2>Websites</h2>
      <p class="lead">Fixed packages in Astro and Sanity. No custom quotes. <a href="/websites/">Payment terms and ownership</a> are on the websites page.</p>
      <div class="plans" style="margin-top:28px">
        {websitePackages.map((pkg) => (
          <article class="plan">
            <h3>{pkg.name}</h3>
            <p class="who">{pkg.pages} · {pkg.weeks} weeks</p>
            <div class="amt">{money(pkg.price)} <span>one-off</span></div>
            <p class="setup">{money(pkg.upfront)} upfront, then {money(pkg.instalment)} × {pkg.months} months, or pay off early</p>
            <ul>{pkg.points.map((p) => <li>{p}</li>)}</ul>
            <a class="btn btn-dark" href="/websites/#enquire">Enquire to see if you qualify</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-shell">
    <div class="wrap">
    <div class="cta-band">
      <LimeBackdrop />
      <h2>Not sure where to start?</h2>
      <p class="lead">The free audit is the first step. Market Leader is a separate, invitation-style application — it is kept off the main menu on purpose.</p>
      <div class="btn-row" style="justify-content:center;margin-top:16px">
        <a class="btn btn-primary" href="/free-audit/">Get the free audit</a>
        <a class="btn btn-ghost" href="/market-leader/">View Market Leader</a>
      </div>
    </div>
    </div>
  </section>
</Base>
