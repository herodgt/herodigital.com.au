---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---
<Base
  title="AI visibility for full-arch and All-on-4 clinics"
  description="Premium AI visibility work for Australian full-arch and All-on-4 centres. $4,995 a month plus setup, or apply for Market Leader. Targets are aims, not guarantees."
  path="/dental-implants/full-arch/"
>
  <PageHero
    eyebrow="Full-arch"
    title="For centres competing on All-on-4 and full-arch questions."
    lead="Premium is the plan built for city-wide full-arch conversations: a content hub, more tracked prompts, a monthly media placement and 10 km metro exclusivity. Market Leader adds mid-tier growth services and a Signature website, by application."
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/dental-implants/', label: 'Dental implants' },
      { href: '/dental-implants/full-arch/', label: 'Full-arch' },
    ]}
  />
  <section class="section">
    <div class="wrap prose">
      <p>We do not quote clinical success rates, and we do not use patient stories. The work is about whether your clinic can be found and accurately described when someone asks an AI tool about full-arch treatment in your city.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/ai-visibility/plans/">See Premium</a>
        <a class="btn btn-ghost" href="/market-leader/">View Market Leader</a>
      </div>
    </div>
  </section>
</Base>
