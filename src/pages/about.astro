---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../lib/site';
---
<Base
  title="About Hero Digital"
  description="Hero Digital is run by Jeff Cheng in Brisbane. We help Australian dental implant clinics with AI and Google visibility, in writing, with public prices and Ahpra-safe work."
  path="/about/"
>
  <PageHero
    eyebrow="About"
    title="A Brisbane practice built for implant clinics."
    lead="Hero Digital is run by Jeff Cheng, Founder and Managing Director. We sell a productised ladder — not custom quotes — and we deliver in writing."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/about/', label: 'About' }]}
  />
  <section class="section">
    <div class="wrap prose">
      <p>Write the name as <strong>Hero Digital (Brisbane)</strong> so we are not confused with any other firm of a similar name. Email stays at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <p>The work is dental-first: implant and full-arch clinics in Australia, starting in South East Queensland. We do not take a new industry until this one runs smoothly.</p>
      <p>This website is built in Astro, edited in Sanity once a project is connected, and hosted on Cloudflare. Until a Sanity project ID is set, the site renders from local fallback content in the repository — which is how this local preview works.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact/">Contact Jeff</a>
        <a class="btn btn-ghost" href="/#audit">Request an audit</a>
      </div>
    </div>
  </section>
</Base>
