---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base
  title="Results"
  description="Hero Digital case studies will be published after pilot clinics complete their first 90 days. No invented statistics, client logos or patient testimonials."
  path="/results/"
>
  <PageHero
    eyebrow="Results"
    title="Case studies coming."
    lead="This page is a placeholder. We will not invent statistics, client logos or patient testimonials to fill it."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/results/', label: 'Results' }]}
  />
  <section class="section">
    <div class="wrap">
      <div class="placeholder">
        <strong>Placeholder — no results to show yet.</strong>
        <p style="margin-top:.6rem">The first write-ups will appear here once pilot clinics complete their first 90 days, with numbers taken from their scoreboards. If a clinic prefers to stay unnamed, the case will be anonymised. Case studies will be about marketing work and measured enquiries, not clinical outcomes or patient stories.</p>
      </div>
      <p class="fine" style="margin-top:20px">If you already work with us and want a private copy of your scoreboard, email <a href="mailto:jcheng@hero.tt">jcheng@hero.tt</a>.</p>
    </div>
  </section>
</Base>
