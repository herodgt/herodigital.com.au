---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---
<Base
  title="SEO"
  description="Implant SEO at a published price, not a custom quote. Part of Hero Digital growth services, sold after a fit check. AUD ex GST."
  path="/growth/seo/"
>
  <PageHero
    eyebrow="Growth services"
    title="SEO"
    lead="Implant SEO at a published price, not a custom quote."
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/growth/', label: 'Growth' },
      { href: '/growth/seo/', label: 'SEO' },
    ]}
  />
  <section class="section">
    <div class="wrap prose">
      <p>Technical and on-page work on implant pages, then a wider programme on Advanced and Authority. We report visibility changes honestly. We do not guarantee rankings.</p>
      <p>Every growth-service engagement starts with a <a href="/growth/fit-check/">fit check</a>. Prices for the three proposed tiers — Essential $2,495, Advanced $3,995 and Authority $5,995 a month — are on the <a href="/growth/">growth services</a> page.</p>
      <a class="btn btn-primary" href="/growth/fit-check/">Check if we’re a good fit</a>
    </div>
  </section>
</Base>
