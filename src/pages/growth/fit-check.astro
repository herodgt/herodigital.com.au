---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Form from '../../components/Form.astro';
---
<Base
  title="Growth services fit check"
  description="Check whether Hero Digital is a good fit for SEO, link building or Google Ads management. Published prices, no custom quotes. Non-fits go to the waitlist."
  path="/growth/fit-check/"
>
  <PageHero
    eyebrow="Fit check"
    title="We’ll tell you honestly if we’re a fit."
    lead="A good fit receives a written start pack at the published price. If we’re not the right firm, or we don’t have capacity, you’ll go to the waitlist — not a long pitch sequence."
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/growth/', label: 'Growth' },
      { href: '/growth/fit-check/', label: 'Fit check' },
    ]}
  />
  <section class="section">
    <div class="wrap page-grid">
      <div class="prose">
        <h2>What we look at</h2>
        <ul>
          <li>Whether you place implants or full-arch treatment in-house</li>
          <li>Whether the monthly band you have in mind matches a published tier</li>
          <li>Capacity in your books, and in ours</li>
          <li>Whether another client already holds exclusivity in your area under an AI Visibility plan</li>
        </ul>
        <p>This form does not start work and does not lock a price change. The prices on the site are the prices we use.</p>
      </div>
      <Form type="fit-check" />
    </div>
  </section>
</Base>
