---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Form from '../components/Form.astro';
import OfferJsonLd from '../components/OfferJsonLd.astro';
import FaqList from '../components/FaqList.astro';
import { websitePackages, money } from '../data/content';

const faqs = [
  { question: 'Do you give custom quotes?', answer: 'No. The three packages are fixed. Page caps and revision limits keep the price firm. Anything beyond the package is a paid add-on, listed in writing before we start it.' },
  { question: 'Who owns the site while we’re paying it off?', answer: 'Hero Digital keeps ownership of the code, the design and the Sanity project until the website is fully paid. You have a licence to use the live site in the meantime. On payoff, those assets transfer to you.' },
  { question: 'Can we pay it off early?', answer: 'Yes. You can clear the remaining balance at any time. Monthly instalments stop once the package is paid in full.' },
  { question: 'What CMS do you use?', answer: 'Sanity, on every site we build — including this one. You can edit pages, posts and settings after launch without waiting on us for small copy changes.' },
];
---
<Base
  title="Custom websites for implant clinics"
  description="Fixed-price Astro and Sanity websites for Australian dental implant clinics. Launch $9,995, Signature $14,995, Flagship $19,995. 50% upfront, then monthly instalments, or pay off early. AUD ex GST."
  path="/websites/"
>
  <OfferJsonLd offers={websitePackages.map((p) => ({ name: `${p.name} website`, path: '/websites/', description: p.pages, price: p.price }))} />
  <PageHero
    eyebrow="Websites"
    title="Three fixed packages. No quotes."
    lead="Built in Astro, edited in Sanity, hosted on Cloudflare, and checked against Ahpra advertising rules before anything goes live. Enquire to see if you qualify on capacity and fit — the price itself is already on this page."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/websites/', label: 'Websites' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="plans">
        {websitePackages.map((pkg) => (
          <article class:list={['plan', pkg.id === 'signature' && 'featured']}>
                        <h3>{pkg.name}</h3>
            <p class="who">{pkg.pages} · delivered in {pkg.weeks} weeks</p>
            <div class="amt">{money(pkg.price)} <span>AUD ex GST</span></div>
            <p class="setup">{money(pkg.upfront)} upfront · then {money(pkg.instalment)} a month for {pkg.months} months</p>
            <ul>{pkg.points.map((p) => <li>{p}</li>)}</ul>
            <a class="btn btn-dark" href="#enquire">Enquire about {pkg.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap">
      <h2>Payment and ownership</h2>
      <p class="lead">Approved 14 November 2026. This schedule is for standalone website purchases. A Signature site included in Hero One is covered by that retainer, not billed again here.</p>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th>Package</th><th>Price</th><th>Upfront (50%)</th><th>Then, or pay off early</th></tr>
          </thead>
          <tbody>
            {websitePackages.map((pkg) => (
              <tr>
                <td>{pkg.name}</td>
                <td class="num">{money(pkg.price)}</td>
                <td class="num">{money(pkg.upfront)}</td>
                <td>{money(pkg.instalment)} a month for {pkg.months} months</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="split" style="margin-top:8px">
        <div class="block">
          <h3>While the balance is outstanding</h3>
          <p>You have a licence to use the live site. Hero Digital keeps ownership of the code, the design and the Sanity project. Hosting stays on Cloudflare under our account until transfer.</p>
        </div>
        <div class="block">
          <h3>When it is fully paid</h3>
          <p>The code, design and Sanity project transfer to you. You can pay off early at any time; the monthly instalments then stop.</p>
        </div>
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} />

  <section class="section bg-cream" id="enquire">
    <div class="wrap page-grid">
      <div>
        <p class="eyebrow">Enquire</p>
        <h2>Tell us which package you’re considering.</h2>
        <p class="lead">This is a qualification and capacity check, not a custom quote. If we’re a fit, we start at the published price. If we’re not, we’ll say so and point you to the waitlist or another option.</p>
      </div>
      <Form type="website" />
    </div>
  </section>
</Base>
