---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/cms';

const entries = await getPosts();
---
<Base
  title="Insights"
  description="Notes on AI search and Ahpra-safe marketing for Australian dental implant clinics. Several pieces are still labelled coming soon."
  path="/insights/"
>
  <PageHero
    eyebrow="Insights"
    title="Notes on AI search for implant clinics."
    lead="Articles are Ahpra-checked before they go live. Anything marked “coming soon” is a placeholder outline, not a published piece."
    crumbs={[{ href: '/', label: 'Home' }, { href: '/insights/', label: 'Insights' }]}
  />
  <section class="section">
    <div class="wrap post-list">
      {entries.map((post) => (
        <a class="post-item" href={`/insights/${post.slug}/`}>
          {post.status === 'coming-soon' && <div class="soon">Coming soon</div>}
          <h3>{post.title}</h3>
          <p class="muted">{post.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
