---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts, getPost } from '../../lib/cms';

export async function getStaticPaths() {
  const entries = await getPosts();
  return entries.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug!);
if (!post) throw new Error('Missing post');
---
<Base
  title={post.title}
  description={post.excerpt}
  path={`/insights/${post.slug}/`}
  ogType="article"
>
  <PageHero
    eyebrow={post.status === 'coming-soon' ? 'Coming soon' : 'Insights'}
    title={post.title}
    lead={post.excerpt}
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/insights/', label: 'Insights' },
      { href: `/insights/${post.slug}/`, label: post.title },
    ]}
  />
  <section class="section">
    <div class="wrap prose">
      {post.status === 'coming-soon' && (
        <p class="notice"><strong>Placeholder outline.</strong> This is not a published article. It will be written and Ahpra-checked before we treat it as live.</p>
      )}
      {post.body.map((p) => <p>{p}</p>)}
      <p><a href="/insights/">Back to insights</a></p>
    </div>
  </section>
</Base>
