---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, abs } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  path: string;
  theme?: 'light' | 'vip';
  ogType?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path,
  theme = 'light',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = abs(path);
const pageTitle = title.includes('Hero Digital') ? title : `${title} | ${SITE.name}`;
const orgLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  email: SITE.email,
  image: abs('/og-image.png'),
  logo: abs('/logo.png'),
  areaServed: 'AU',
  founder: { '@type': 'Person', name: SITE.founder },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressCountry: 'AU',
  },
  description: SITE.description,
};
const graph = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme === "vip" ? "#131314" : SITE.themeColor} />
    <meta name="form-endpoint" content={SITE.formEndpoint} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/og-image.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs('/og-image.png')} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <JsonLd data={graph} />
  </head>
  <body class={theme === 'vip' ? 'page-vip' : 'page-home'}>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const menu = document.querySelector('.nav-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      const endpoint = (document.querySelector('meta[name="form-endpoint"]') as HTMLMetaElement | null)?.content?.trim();
      document.querySelectorAll<HTMLFormElement>('form[data-hero-form]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const status = form.querySelector<HTMLElement>('.form-status');
          const payload = Object.fromEntries(new FormData(form).entries());
          if (!endpoint) {
            if (status) {
              status.className = 'form-status show ok';
              status.textContent =
                'This local preview does not send the form. When the site is live, set PUBLIC_FORM_ENDPOINT to a Cloudflare Worker or Formspree URL and this request will be posted there. You can also email jcheng@hero.tt.';
            }
            return;
          }
          try {
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error('Request failed');
            if (status) {
              status.className = 'form-status show ok';
              status.textContent = 'Thanks. We’ll reply in writing to the email you gave us.';
            }
            form.reset();
          } catch {
            if (status) {
              status.className = 'form-status show err';
              status.textContent = 'We couldn’t send that just now. Please email jcheng@hero.tt instead.';
            }
          }
        });
      });
    </script>
  </body>
</html>
