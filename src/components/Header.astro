---
import { NAV } from '../lib/site';
interface Props { path: string; theme?: 'light' | 'vip' }
const { path, theme = 'light' } = Astro.props;
function current(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
const logo = theme === 'vip' ? '/logo-light.svg' : '/logo-dark.svg';
---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/">
      <img class="brand-logo" src={logo} alt="Hero Digital" width="141" height="32" />
    </a>
    <nav class="nav-menu" aria-label="Primary">
      <ul class="nav-links">
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav-end">
      <a class="btn btn-primary btn-sm" href="/free-audit/">Free Audit</a>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false"><span></span></button>
    </div>
  </div>
</header>
