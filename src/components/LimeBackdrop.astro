---
interface Props { parallax?: boolean }
const { parallax = false } = Astro.props;
---
<div
  class:list={['lime-stage', parallax && 'lime-stage--parallax']}
  data-parallax={parallax ? '0.08' : undefined}
  aria-hidden="true"
>
  <div class="lime-fallback"></div>
  <canvas class="lime-canvas" data-lime-canvas></canvas>
</div>
