---
import { SITE, FINE_PRINT } from '../lib/site';
interface Props { theme?: 'light' | 'vip' }
const { theme = 'light' } = Astro.props;
const logo = theme === 'vip' ? '/logo-light.svg' : '/logo-dark.svg';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/" style="margin-bottom:14px">
          <img class="brand-logo" src={logo} alt="Hero Digital" width="141" height="32" />
        </a>
        <p>AI and Google visibility for Australian dental implant clinics. Written-only delivery, from Brisbane.</p>
      </div>
      <div>
        <p class="footer-label">Services</p>
        <ul>
          <li><a href="/ai-visibility/">AI Visibility</a></li>
          <li><a href="/ai-visibility/fix-sprint/">Fix Sprint</a></li>
          <li><a href="/growth-services/">Growth Services</a></li>
          <li><a href="/websites/">Websites</a></li>
          <li><a href="/market-leader/">Market Leader — by application</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-label">Practice</p>
        <ul>
          <li><a href="/how-it-works/">How it works</a></li>
          <li><a href="/results/">Results</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/dental-implants/ahpra-compliance/">Ahpra compliance</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-label">Contact</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>Hero Digital (Brisbane)</li>
          <li><a href="/legal/privacy/">Privacy</a> · <a href="/legal/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} Hero Digital (Brisbane). Prices are AUD ex GST.</span>
      <span>{FINE_PRINT}</span>
    </div>
  </div>
</footer>
