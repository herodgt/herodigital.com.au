{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herodigital",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
