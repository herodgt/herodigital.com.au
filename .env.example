# Leave SANITY_PROJECT_ID unset to build from local fallback content in src/data/.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Optional, public-safe project id if you prefer the PUBLIC_ prefix:
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=production

# Where forms POST as JSON. Leave blank for local preview (the form will not send).
# Later: a Cloudflare Worker URL or Formspree endpoint.
PUBLIC_FORM_ENDPOINT=
